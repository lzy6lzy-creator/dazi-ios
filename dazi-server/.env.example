POSTGRES_PASSWORD=<strong-postgres-password>
JWT_SECRET=<openssl-rand-hex-32>
ADMIN_TOKEN=<admin-token>

AGENT_MODEL_PROVIDER=kimi
AGENT_MODEL=kimi-k2.5
AGENT_BASE_URL=https://api.moonshot.cn/v1
AGENT_API_KEY=<Agent API Key>
# Legacy fallback names accepted by docker-compose interpolation during migration.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

ALIYUN_DYPNS_ACCESS_KEY_ID=<aliyun-ram-access-key-id>
ALIYUN_DYPNS_ACCESS_KEY_SECRET=<aliyun-ram-access-key-secret>
ALIYUN_DYPNS_REGION_ID=cn-hangzhou
ALIYUN_DYPNS_SCHEME_NAME=默认方案
ALIYUN_DYPNS_SIGN_NAME=<aliyun-system-sign-name>
ALIYUN_DYPNS_TEMPLATE_CODE=100001
ALIYUN_DYPNS_ENABLED=true

# Backend-only internal testers. Do not ship these values in a client build.
INTERNAL_TEST_CODE=121212
INTERNAL_TEST_PHONES=
INTERNAL_TEST_PHONES_FILE=/code/runtime-config/internal_test_phones.txt

INVITATION_IOS_DISTRIBUTION_MODE=testflight
INVITATION_TESTFLIGHT_PUBLIC_URL=<testflight-public-link>
INVITATION_APP_STORE_URL=

ASC_KEY_ID=<app-store-connect-key-id>
ASC_ISSUER_ID=<app-store-connect-issuer-id>
ASC_PRIVATE_KEY_PATH=/code/runtime-secrets/AuthKey_XXXXXX.p8
ASC_BUNDLE_ID=com.linke.dazi
ASC_APP_ID=6776567684
ASC_INTERNAL_GROUP_NAME=搭子test
ASC_INTERNAL_GROUP_ID=7634faa9-7562-42b4-8368-2b06e9c6a244
ASC_INVITE_ROLE=MARKETING

APNS_KEY_ID=<apple-push-key-id>
APNS_TEAM_ID=<apple-developer-team-id>
